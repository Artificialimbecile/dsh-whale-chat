{
  "name": "dsh-whale-chat",
  "version": "0.1.2",
  "description": "鲸聊：一只会说话的鲸鱼桌宠（dsh-pet 二次创作）。陪你聊天、有人设、会自己随机上网逛一圈再把见闻带回来告诉你。",
  "icon": "./icon.png",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "chat",
    "persona",
    "web-roam",
    "cordis"
  ],
  "homepage": "https://github.com/Artificialimbecile/dsh-whale-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artificialimbecile/dsh-whale-chat.git"
  },
  "bugs": {
    "url": "https://github.com/Artificialimbecile/dsh-whale-chat/issues"
  },
  "author": "Artificialimbecile",
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "license": "MIT"
}
